# Copie para .env e preencha. NUNCA versione o .env preenchido.

# ---- Slack ----
# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-troque-aqui
# App-Level Token com escopo connections:write (Basic Information)
SLACK_APP_TOKEN=xapp-troque-aqui
# Canal onde os alertas sao postados (o bot precisa estar no canal)
SLACK_CHANNEL=#soc-alerts

# ---- DFIR-IRIS ----
# URL interna, usada pelo bridge dentro da rede do Docker
IRIS_URL_INTERNAL=https://iris-nginx
# URL que o analista abre no navegador (vai nos links dos botoes)
IRIS_URL_PUBLIC=https://192.168.18.10
# API key de um usuario administrativo do IRIS
IRIS_API_KEY=troque-aqui
IRIS_CUSTOMER_ID=1
# TLS: em LAB deixe false (cert autoassinado). Em PRODUCAO use true.
IRIS_VERIFY_TLS=false
# Opcional: caminho (dentro do container) de um bundle de CA para validar o
# certificado do IRIS. Se definido, tem prioridade sobre IRIS_VERIFY_TLS.
# IRIS_CA_BUNDLE=/certs/ca.pem

# ---- Seguranca da ingestao ----
# Token exigido no POST /wazuh. DEFINA em producao (qualquer string forte) e
# use o MESMO valor no campo <api_key> da integracao no ossec.conf.
# Vazio = sem autenticacao (apenas lab isolado).
INGEST_TOKEN=

# ---- Docker ----
# Nome da rede Docker do seu stack de SOC (onde vivem Wazuh/IRIS).
# Descubra com: docker network ls | grep -i soc
SOC_NETWORK=soc-lab_soc-net

# ---- Wazuh ----
WAZUH_DASHBOARD_URL=https://192.168.18.10:4443

# ---- Fila / durabilidade ----
# Tentativas antes de mover para dead-letter, intervalo de polling e base do
# backoff exponencial (segundos).
QUEUE_MAX_ATTEMPTS=6
QUEUE_POLL_SEC=2
QUEUE_BACKOFF_BASE_SEC=5

# ---- Bridge ----
BRIDGE_PORT=8000
DB_PATH=/data/bridge.db
LOG_LEVEL=INFO

# Fechar via modal (resolucao + nota). false = fecha direto.
CLOSE_WITH_MODAL=true

# Mapeamento manual Slack -> IRIS, usado quando o e-mail nao bate.
# Formato: {"U01ABCDEF":"login_no_iris","U02GHIJKL":"outro_login"}
SLACK_IRIS_USER_MAP={}

# ---- Docker secrets (opcional) ----
# Em vez de deixar segredos aqui, monte-os como arquivos e aponte via *_FILE.
# O valor do arquivo tem prioridade sobre a variavel de mesmo nome.
# SLACK_BOT_TOKEN_FILE=/run/secrets/slack_bot_token
# SLACK_APP_TOKEN_FILE=/run/secrets/slack_app_token
# IRIS_API_KEY_FILE=/run/secrets/iris_api_key
# INGEST_TOKEN_FILE=/run/secrets/ingest_token
